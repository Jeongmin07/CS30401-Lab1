+++ b/scratch/main_satnet/study_drop_trace.h
@@ -0,0 +1,115 @@
+#ifndef CS30401_STUDY_DROP_TRACE_H
+#define CS30401_STUDY_DROP_TRACE_H
+
+#include "ns3/ipv4-l3-protocol.h"
+#include "ns3/ipv4-header.h"
+#include "ns3/tcp-header.h"
+#include "ns3/ppp-header.h"
+#include "ns3/point-to-point-laser-net-device.h"
+#include "ns3/gsl-net-device.h"
+#include "ns3/point-to-point-net-device.h"
+#include "ns3/tcp-flow-send-application.h"
+#include "ns3/traffic-control-layer.h"
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+
+namespace ns3 {
+namespace cs30401study {
+static std::unique_ptr<std::ofstream> drops;
+static std::unique_ptr<std::ofstream> coverage;
+
+static void WriteDrop(uint32_t node, uint32_t device, const std::string& layer,
+                      int reason, Ptr<const Packet> packet, const Ipv4Header* ip = nullptr) {
+    Ptr<Packet> copy = packet->Copy();
+    Ipv4Header header;
+    bool parsed = false;
+    if (ip) {
+        header = *ip;
+        parsed = true;
+    } else if (copy->GetSize() >= 20) {
+        uint8_t first[2];
+        copy->CopyData(first, 2);
+        if ((first[0] >> 4) != 4 && first[0] == 0 && first[1] == 0x21) {
+            PppHeader ppp;
+            copy->RemoveHeader(ppp);
+        }
+        copy->CopyData(first, 1);
+        if ((first[0] >> 4) == 4) parsed = copy->RemoveHeader(header) > 0;
+    }
+    *drops << Simulator::Now().GetNanoSeconds() << ',' << layer << ',' << node << ','
+           << device << ',' << reason << ',' << packet->GetUid() << ',';
+    if (parsed) *drops << header.GetSource() << ',' << header.GetDestination();
+    else *drops << ',';
+    *drops << ',';
+    if (parsed && header.GetProtocol() == 6 && header.GetFragmentOffset() == 0 && copy->GetSize() >= 20) {
+        TcpHeader tcp;
+        copy->RemoveHeader(tcp);
+        *drops << tcp.GetSourcePort() << ',' << tcp.GetDestinationPort() << ','
+               << tcp.GetSequenceNumber().GetValue() << ',' << copy->GetSize() << ',' << unsigned(tcp.GetFlags());
+    } else *drops << ",,,,";
+    TcpStudyTxTag tag;
+    if (packet->PeekPacketTag(tag)) {
+        *drops << ',' << tag.GetFlowId() << ',' << tag.GetTxId() << ',' << tag.GetTxTimeNs();
+    } else *drops << ",,,";
+    *drops << '\n';
+}
+
+static void DeviceDrop(uint32_t node, uint32_t device, std::string layer, Ptr<const Packet> packet) {
+    WriteDrop(node, device, layer, -1, packet);
+}
+static void IpDrop(uint32_t node, const Ipv4Header& header, Ptr<const Packet> packet,
+                   Ipv4L3Protocol::DropReason reason, Ptr<Ipv4> ipv4, uint32_t interface) {
+    WriteDrop(node, interface, "ipv4", int(reason), packet, &header);
+}
+
+static void Install(NodeContainer nodes) {
+    const char* enabled = std::getenv("CS30401_STUDY_TRACE");
+    if (!enabled || std::string(enabled) != "1") return;
+    const char* folder = std::getenv("CS30401_STUDY_TRACE_DIR");
+    if (!folder) throw std::runtime_error("CS30401_STUDY_TRACE_DIR is required for study traces");
+    drops = std::make_unique<std::ofstream>(std::string(folder) + "/study_drops.csv");
+    coverage = std::make_unique<std::ofstream>(std::string(folder) + "/study_drop_coverage.csv");
+    if (!*drops || !*coverage) throw std::runtime_error("Cannot open study drop traces");
+    *drops << "time_ns,layer,node,device,reason,uid,src,dst,src_port,dst_port,seq,payload_bytes,flags,flow_id,tx_id,tx_time_ns\n";
+    *coverage << "node,device,layer,connected\n";
+    for (auto it = nodes.Begin(); it != nodes.End(); ++it) {
+        Ptr<Node> node = *it;
+        Ptr<Ipv4L3Protocol> ip = node->GetObject<Ipv4L3Protocol>();
+        bool ok = ip && ip->TraceConnectWithoutContext("Drop", MakeBoundCallback(&IpDrop, node->GetId()));
+        *coverage << node->GetId() << ",-1,ipv4," << ok << '\n';
+        if (!ok) throw std::runtime_error("Missing IPv4 drop trace");
+        Ptr<TrafficControlLayer> tc = node->GetObject<TrafficControlLayer>();
+        ok = tc && tc->TraceConnectWithoutContext("TcDrop",
+             MakeBoundCallback(&DeviceDrop, node->GetId(), uint32_t(-1), std::string("TcDrop")));
+        *coverage << node->GetId() << ",-1,TcDrop," << ok << '\n';
+        if (!ok) throw std::runtime_error("Missing traffic-control drop trace");
+        for (uint32_t index = 0; index < node->GetNDevices(); ++index) {
+            Ptr<NetDevice> device = node->GetDevice(index);
+            Ptr<Queue<Packet>> queue;
+            if (auto isl = DynamicCast<PointToPointLaserNetDevice>(device)) queue = isl->GetQueue();
+            else if (auto gsl = DynamicCast<GSLNetDevice>(device)) queue = gsl->GetQueue();
+            else if (auto p2p = DynamicCast<PointToPointNetDevice>(device)) queue = p2p->GetQueue();
+            else continue; // Loopback is not an ISL/GSL forwarding link.
+            ok = !tc->GetRootQueueDiscOnDevice(device);
+            *coverage << node->GetId() << ',' << index << ",root_queue_disc_absent," << ok << '\n';
+            if (!ok) throw std::runtime_error("Root queue disc requires a QueueDisc::Drop hook or explicit removal");
+            // MacRxDrop is unimplemented (#if 0) in these device classes.
+            for (const std::string layer : {"MacTxDrop", "PhyTxDrop", "PhyRxDrop"}) {
+                ok = device->TraceConnectWithoutContext(layer, MakeBoundCallback(&DeviceDrop, node->GetId(), index, layer));
+                *coverage << node->GetId() << ',' << index << ',' << layer << ',' << ok << '\n';
+                if (!ok) throw std::runtime_error("Missing device drop trace: " + layer);
+            }
+            if (!queue) throw std::runtime_error("Missing ISL/GSL queue");
+            for (const std::string layer : {"DropBeforeEnqueue", "DropAfterDequeue"}) {
+                ok = queue->TraceConnectWithoutContext(layer, MakeBoundCallback(&DeviceDrop, node->GetId(), index, layer));
+                *coverage << node->GetId() << ',' << index << ',' << layer << ',' << ok << '\n';
+                if (!ok) throw std::runtime_error("Missing queue drop trace: " + layer);
+            }
+        }
+    }
+    coverage->flush();
+}
+} // namespace cs30401study
+} // namespace ns3
+#endif
diff --git a/scratch/study_micro/study_micro.cc b/scratch/study_micro/study_micro.cc
new file mode 100755
index 0000000..6b58540
--- /dev/null
+++ b/scratch/study_micro/study_micro.cc
@@ -0,0 +1,103 @@
+// Controlled delay-step diagnostic. It is not a replacement for the LEO model.
+#include "ns3/core-module.h"
+#include "ns3/network-module.h"
+#include "ns3/internet-module.h"
+#include "ns3/point-to-point-module.h"
+#include "ns3/traffic-control-module.h"
+#include "ns3/tcp-flow-send-helper.h"
+#include "ns3/tcp-flow-sink-helper.h"
+#include "ns3/tcp-flow-send-application.h"
+#include "../main_satnet/study_drop_trace.h"
+#include <filesystem>
+using namespace ns3;
+
+class StudyDropOnce : public ErrorModel {
+public:
+    StudyDropOnce(double time, uint32_t sequence) : m_time(time), m_sequence(sequence) {}
+private:
+    bool DoCorrupt(Ptr<Packet> packet) override {
+        if (m_used || (m_time < 0 && m_sequence == 0) ||
+            (m_time >= 0 && Simulator::Now().GetSeconds() < m_time)) return false;
+        auto copy = packet->Copy();
+        PppHeader ppp; Ipv4Header ip; TcpHeader tcp;
+        if (copy->GetSize() < 42) return false;
+        copy->RemoveHeader(ppp);
+        if (ppp.GetProtocol() != 0x21) return false;
+        copy->RemoveHeader(ip);
+        if (ip.GetProtocol() != 6) return false;
+        copy->RemoveHeader(tcp);
+        if (!copy->GetSize()) return false;
+        if (m_sequence != 0 && tcp.GetSequenceNumber().GetValue() != m_sequence) return false;
+        m_used = true;
+        return true;
+    }
+    void DoReset() override { m_used = false; }
+    double m_time;
+    uint32_t m_sequence;
+    bool m_used = false;
+};
+
+int main(int argc, char** argv) {
+    std::string run_dir, parameters, cc = "TcpCubic";
+    double duration = 20, rate = 100, before_ms = 50, after_ms = 45, event_s = 10, loss_s = -1, flow_start_s = 0;
+    uint32_t queue_pkts = 2000, initial_ssthresh_pkts = 900, loss_seq = 0;
+    uint64_t max_bytes = 100000000000ULL;
+    CommandLine cmd;
+    cmd.AddValue("run_dir", "Output directory", run_dir);
+    cmd.AddValue("parameters", "TCP study additional parameters", parameters);
+    cmd.AddValue("cc", "TCP class name", cc);
+    cmd.AddValue("duration", "Simulation seconds", duration);
+    cmd.AddValue("rate", "Link Mbit/s", rate);
+    cmd.AddValue("before_ms", "Initial one-way propagation ms", before_ms);
+    cmd.AddValue("after_ms", "One-way propagation after step ms", after_ms);
+    cmd.AddValue("event_s", "Delay-step time", event_s);
+    cmd.AddValue("loss_s", "Drop one data packet at or after this time (-1 disables)", loss_s);
+    cmd.AddValue("loss_seq", "Only drop this starting TCP data sequence once (0 uses time only)", loss_seq);
+    cmd.AddValue("queue_pkts", "Drop-tail queue packets", queue_pkts);
+    cmd.AddValue("initial_ssthresh_pkts", "Controlled initial slow-start threshold packets", initial_ssthresh_pkts);
+    cmd.AddValue("max_bytes", "Finite transfer bytes (default effectively infinite)", max_bytes);
+    cmd.AddValue("flow_start_s", "Application start time in simulation seconds", flow_start_s);
+    cmd.Parse(argc, argv);
+    if (run_dir.empty()) throw std::runtime_error("run_dir required");
+    std::filesystem::create_directories(run_dir + "/logs_ns3");
+    Config::SetDefault("ns3::TcpL4Protocol::SocketType", StringValue("ns3::" + cc));
+    Config::SetDefault("ns3::TcpSocket::SegmentSize", UintegerValue(1380));
+    Config::SetDefault("ns3::TcpSocket::SndBufSize", UintegerValue(32*1024*1024));
+    Config::SetDefault("ns3::TcpSocket::RcvBufSize", UintegerValue(32*1024*1024));
+    Config::SetDefault("ns3::TcpSocket::InitialSlowStartThreshold", UintegerValue(initial_ssthresh_pkts*1380));
+    Config::SetDefault("ns3::TcpSocketState::EnablePacing", BooleanValue(cc == "TcpBbr"));
+    NodeContainer nodes; nodes.Create(2);
+    InternetStackHelper stack; stack.Install(nodes);
+    PointToPointHelper link;
+    link.SetDeviceAttribute("DataRate", StringValue(std::to_string(rate) + "Mbps"));
+    link.SetChannelAttribute("Delay", TimeValue(MilliSeconds(before_ms)));
+    link.SetQueue("ns3::DropTailQueue<Packet>", "MaxSize", QueueSizeValue(QueueSize(std::to_string(queue_pkts)+"p")));
+    auto devices = link.Install(nodes);
+    Ipv4AddressHelper addresses; addresses.SetBase("10.1.1.0", "255.255.255.0");
+    auto interfaces = addresses.Assign(devices);
+    // Match the course's device-only drop-tail queues; address assignment can
+    // otherwise install a default AQM root qdisc and confound the delay-step test.
+    TrafficControlHelper traffic;
+    traffic.Uninstall(devices);
+    if (loss_s >= 0 || loss_seq != 0) {
+        auto em = CreateObject<StudyDropOnce>(loss_s, loss_seq);
+        devices.Get(1)->SetAttribute("ReceiveErrorModel", PointerValue(em));
+    }
+    cs30401study::Install(nodes);
+    TcpFlowSinkHelper sink("ns3::TcpSocketFactory", InetSocketAddress(Ipv4Address::GetAny(), 1024));
+    auto sinks = sink.Install(nodes.Get(1)); sinks.Start(Seconds(0));
+    TcpFlowSendHelper source("ns3::TcpSocketFactory", InetSocketAddress(interfaces.GetAddress(1),1024),
+                             max_bytes, 0, true, run_dir+"/logs_ns3", parameters);
+    auto apps = source.Install(nodes.Get(0)); apps.Start(Seconds(flow_start_s));
+    auto channel = DynamicCast<PointToPointChannel>(devices.Get(0)->GetChannel());
+    Simulator::Schedule(Seconds(event_s), [channel, after_ms]() {
+        channel->SetAttribute("Delay", TimeValue(MilliSeconds(after_ms)));
+    });
+    Simulator::Stop(Seconds(duration));
+    Simulator::Run();
+    apps.Get(0)->GetObject<TcpFlowSendApplication>()->FinalizeDetailedLogs();
+    std::ofstream config(run_dir+"/config_ns3.properties");
+    config << "simulation_end_time_ns=" << int64_t(duration*1e9) << '\n';
+    Simulator::Destroy();
+    return 0;
+}
