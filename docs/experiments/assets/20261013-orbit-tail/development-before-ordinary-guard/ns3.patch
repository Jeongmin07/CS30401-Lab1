+
+bool
+TcpSocketBase::ReevaluateLossAfterThresholdRestore()
+{
+    NS_ABORT_MSG_IF(m_retxThresh != 3 || !m_sackEnabled || m_fackEnabled,
+                    "Bounded restoration requires baseline K3, SACK and no FACK");
+    // Do not duplicate ECN/RTO/ongoing recovery or manufacture an ACK.
+    if (m_tcb->m_congState != TcpSocketState::CA_DISORDER) return false;
+    m_txBuffer->ReevaluateLoss();
+    const bool dupackLoss = m_dupAckCount >= m_retxThresh &&
+        (m_highRxAckMark >= m_recover || !m_recoverActive);
+    if (!dupackLoss && !m_txBuffer->IsLost(m_highRxAckMark)) return false;
+    // A timer delivers no new bytes: currentDelivered is zero, not a total.
+    EnterRecovery(0);
+    SendPendingData(m_connected);
+    return true;
+}
