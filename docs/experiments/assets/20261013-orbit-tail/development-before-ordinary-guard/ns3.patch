+        std::ostringstream text;
+        if (InetSocketAddress::IsMatchingType(address)) {
+            InetSocketAddress inet = InetSocketAddress::ConvertFrom(address);
+            text << inet.GetIpv4();
+            port = inet.GetPort();
+        } else if (Inet6SocketAddress::IsMatchingType(address)) {
+            Inet6SocketAddress inet = Inet6SocketAddress::ConvertFrom(address);
+            text << inet.GetIpv6();
+            port = inet.GetPort();
+        } else {
+            text << "unknown";
+        }
+        ip = text.str();
+    };
+    describe(localAddress, connection.localIp, connection.localPort);
+    describe(peerAddress, connection.peerIp, connection.peerPort);
+
+    if (!m_studyRxCsv.is_open()) {
+        std::string suffix = "_node_" + std::to_string(GetNode()->GetId())
