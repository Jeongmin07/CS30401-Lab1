diff --git a/scratch/main_satnet/study_drop_trace.h b/scratch/main_satnet/study_drop_trace.h
new file mode 100755
index 0000000..c9c2c0f
--- /dev/null
+++ b/scratch/main_satnet/study_drop_trace.h
@@ -0,0 +1,115 @@
+#ifndef CS30401_STUDY_DROP_TRACE_H
+#define CS30401_STUDY_DROP_TRACE_H
+
+#include "ns3/ipv4-l3-protocol.h"
+#include "ns3/ipv4-header.h"
+#include "ns3/tcp-header.h"
+#include "ns3/ppp-header.h"
+#include "ns3/point-to-point-laser-net-device.h"
+#include "ns3/gsl-net-device.h"
+#include "ns3/point-to-point-net-device.h"
+#include "ns3/tcp-flow-send-application.h"
+#include "ns3/traffic-control-layer.h"
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+
+namespace ns3 {
+namespace cs30401study {
+static std::unique_ptr<std::ofstream> drops;
+static std::unique_ptr<std::ofstream> coverage;
+
+static void WriteDrop(uint32_t node, uint32_t device, const std::string& layer,
+                      int reason, Ptr<const Packet> packet, const Ipv4Header* ip = nullptr) {
+    Ptr<Packet> copy = packet->Copy();
+    Ipv4Header header;
+    bool parsed = false;
+    if (ip) {
+        header = *ip;
+        parsed = true;
+    } else if (copy->GetSize() >= 20) {
+        uint8_t first[2];
+        copy->CopyData(first, 2);
+        if ((first[0] >> 4) != 4 && first[0] == 0 && first[1] == 0x21) {
+            PppHeader ppp;
+            copy->RemoveHeader(ppp);
+        }
+        copy->CopyData(first, 1);
+        if ((first[0] >> 4) == 4) parsed = copy->RemoveHeader(header) > 0;
+    }
+    *drops << Simulator::Now().GetNanoSeconds() << ',' << layer << ',' << node << ','
+           << device << ',' << reason << ',' << packet->GetUid() << ',';
+    if (parsed) *drops << header.GetSource() << ',' << header.GetDestination();
+    else *drops << ',';
+    *drops << ',';
+    if (parsed && header.GetProtocol() == 6 && header.GetFragmentOffset() == 0 && copy->GetSize() >= 20) {
+        TcpHeader tcp;
+        copy->RemoveHeader(tcp);
+        *drops << tcp.GetSourcePort() << ',' << tcp.GetDestinationPort() << ','
+               << tcp.GetSequenceNumber().GetValue() << ',' << copy->GetSize() << ',' << unsigned(tcp.GetFlags());
+    } else *drops << ",,,,";
+    TcpStudyTxTag tag;
+    if (packet->PeekPacketTag(tag)) {
+        *drops << ',' << tag.GetFlowId() << ',' << tag.GetTxId() << ',' << tag.GetTxTimeNs();
+    } else *drops << ",,,";
+    *drops << '\n';
+}
+
+static void DeviceDrop(uint32_t node, uint32_t device, std::string layer, Ptr<const Packet> packet) {
+    WriteDrop(node, device, layer, -1, packet);
+}
+static void IpDrop(uint32_t node, const Ipv4Header& header, Ptr<const Packet> packet,
+                   Ipv4L3Protocol::DropReason reason, Ptr<Ipv4> ipv4, uint32_t interface) {
+    WriteDrop(node, interface, "ipv4", int(reason), packet, &header);
+}
+
+static void Install(NodeContainer nodes) {
+    const char* enabled = std::getenv("CS30401_STUDY_TRACE");
+    if (!enabled || std::string(enabled) != "1") return;
+    const char* folder = std::getenv("CS30401_STUDY_TRACE_DIR");
+    if (!folder) throw std::runtime_error("CS30401_STUDY_TRACE_DIR is required for study traces");
+    drops = std::make_unique<std::ofstream>(std::string(folder) + "/study_drops.csv");
+    coverage = std::make_unique<std::ofstream>(std::string(folder) + "/study_drop_coverage.csv");
+    if (!*drops || !*coverage) throw std::runtime_error("Cannot open study drop traces");
+    *drops << "time_ns,layer,node,device,reason,uid,src,dst,src_port,dst_port,seq,payload_bytes,flags,flow_id,tx_id,tx_time_ns\n";
+    *coverage << "node,device,layer,connected\n";
+    for (auto it = nodes.Begin(); it != nodes.End(); ++it) {
+        Ptr<Node> node = *it;
+        Ptr<Ipv4L3Protocol> ip = node->GetObject<Ipv4L3Protocol>();
+        bool ok = ip && ip->TraceConnectWithoutContext("Drop", MakeBoundCallback(&IpDrop, node->GetId()));
+        *coverage << node->GetId() << ",-1,ipv4," << ok << '\n';
+        if (!ok) throw std::runtime_error("Missing IPv4 drop trace");
+        Ptr<TrafficControlLayer> tc = node->GetObject<TrafficControlLayer>();
+        ok = tc && tc->TraceConnectWithoutContext("TcDrop",
+             MakeBoundCallback(&DeviceDrop, node->GetId(), uint32_t(-1), std::string("TcDrop")));
+        *coverage << node->GetId() << ",-1,TcDrop," << ok << '\n';
+        if (!ok) throw std::runtime_error("Missing traffic-control drop trace");
+        for (uint32_t index = 0; index < node->GetNDevices(); ++index) {
+            Ptr<NetDevice> device = node->GetDevice(index);
+            Ptr<Queue<Packet>> queue;
+            if (auto isl = DynamicCast<PointToPointLaserNetDevice>(device)) queue = isl->GetQueue();
+            else if (auto gsl = DynamicCast<GSLNetDevice>(device)) queue = gsl->GetQueue();
+            else if (auto p2p = DynamicCast<PointToPointNetDevice>(device)) queue = p2p->GetQueue();
+            else continue; // Loopback is not an ISL/GSL forwarding link.
+            ok = !tc->GetRootQueueDiscOnDevice(device);
+            *coverage << node->GetId() << ',' << index << ",root_queue_disc_absent," << ok << '\n';
+            if (!ok) throw std::runtime_error("Root queue disc requires a QueueDisc::Drop hook or explicit removal");
+            // MacRxDrop is unimplemented (#if 0) in these device classes.
+            for (const std::string layer : {"MacTxDrop", "PhyTxDrop", "PhyRxDrop"}) {
+                ok = device->TraceConnectWithoutContext(layer, MakeBoundCallback(&DeviceDrop, node->GetId(), index, layer));
+                *coverage << node->GetId() << ',' << index << ',' << layer << ',' << ok << '\n';
+                if (!ok) throw std::runtime_error("Missing device drop trace: " + layer);
+            }
+            if (!queue) throw std::runtime_error("Missing ISL/GSL queue");
+            for (const std::string layer : {"DropBeforeEnqueue", "DropAfterDequeue"}) {
+                ok = queue->TraceConnectWithoutContext(layer, MakeBoundCallback(&DeviceDrop, node->GetId(), index, layer));
+                *coverage << node->GetId() << ',' << index << ',' << layer << ',' << ok << '\n';
+                if (!ok) throw std::runtime_error("Missing queue drop trace: " + layer);
+            }
+        }
+    }
+    coverage->flush();
+}
+} // namespace cs30401study
+} // namespace ns3
+#endif
diff --git a/scratch/study_micro/study_micro.cc b/scratch/study_micro/study_micro.cc
new file mode 100755
index 0000000..6b58540
--- /dev/null
+++ b/scratch/study_micro/study_micro.cc
@@ -0,0 +1,103 @@
+// Controlled delay-step diagnostic. It is not a replacement for the LEO model.
+#include "ns3/core-module.h"
+#include "ns3/network-module.h"
+#include "ns3/internet-module.h"
+#include "ns3/point-to-point-module.h"
+#include "ns3/traffic-control-module.h"
+#include "ns3/tcp-flow-send-helper.h"
+#include "ns3/tcp-flow-sink-helper.h"
+#include "ns3/tcp-flow-send-application.h"
+#include "../main_satnet/study_drop_trace.h"
+#include <filesystem>
+using namespace ns3;
+
+class StudyDropOnce : public ErrorModel {
+public:
+    StudyDropOnce(double time, uint32_t sequence) : m_time(time), m_sequence(sequence) {}
+private:
+    bool DoCorrupt(Ptr<Packet> packet) override {
+        if (m_used || (m_time < 0 && m_sequence == 0) ||
+            (m_time >= 0 && Simulator::Now().GetSeconds() < m_time)) return false;
+        auto copy = packet->Copy();
+        PppHeader ppp; Ipv4Header ip; TcpHeader tcp;
+        if (copy->GetSize() < 42) return false;
+        copy->RemoveHeader(ppp);
+        if (ppp.GetProtocol() != 0x21) return false;
+        copy->RemoveHeader(ip);
+        if (ip.GetProtocol() != 6) return false;
+        copy->RemoveHeader(tcp);
+        if (!copy->GetSize()) return false;
+        if (m_sequence != 0 && tcp.GetSequenceNumber().GetValue() != m_sequence) return false;
+        m_used = true;
+        return true;
+    }
+    void DoReset() override { m_used = false; }
+    double m_time;
+    uint32_t m_sequence;
+    bool m_used = false;
+};
+
+int main(int argc, char** argv) {
+    std::string run_dir, parameters, cc = "TcpCubic";
+    double duration = 20, rate = 100, before_ms = 50, after_ms = 45, event_s = 10, loss_s = -1, flow_start_s = 0;
+    uint32_t queue_pkts = 2000, initial_ssthresh_pkts = 900, loss_seq = 0;
+    uint64_t max_bytes = 100000000000ULL;
+    CommandLine cmd;
+    cmd.AddValue("run_dir", "Output directory", run_dir);
+    cmd.AddValue("parameters", "TCP study additional parameters", parameters);
+    cmd.AddValue("cc", "TCP class name", cc);
+    cmd.AddValue("duration", "Simulation seconds", duration);
+    cmd.AddValue("rate", "Link Mbit/s", rate);
+    cmd.AddValue("before_ms", "Initial one-way propagation ms", before_ms);
+    cmd.AddValue("after_ms", "One-way propagation after step ms", after_ms);
+    cmd.AddValue("event_s", "Delay-step time", event_s);
+    cmd.AddValue("loss_s", "Drop one data packet at or after this time (-1 disables)", loss_s);
+    cmd.AddValue("loss_seq", "Only drop this starting TCP data sequence once (0 uses time only)", loss_seq);
+    cmd.AddValue("queue_pkts", "Drop-tail queue packets", queue_pkts);
+    cmd.AddValue("initial_ssthresh_pkts", "Controlled initial slow-start threshold packets", initial_ssthresh_pkts);
+    cmd.AddValue("max_bytes", "Finite transfer bytes (default effectively infinite)", max_bytes);
+    cmd.AddValue("flow_start_s", "Application start time in simulation seconds", flow_start_s);
+    cmd.Parse(argc, argv);
+    if (run_dir.empty()) throw std::runtime_error("run_dir required");
+    std::filesystem::create_directories(run_dir + "/logs_ns3");
+    Config::SetDefault("ns3::TcpL4Protocol::SocketType", StringValue("ns3::" + cc));
+    Config::SetDefault("ns3::TcpSocket::SegmentSize", UintegerValue(1380));
+    Config::SetDefault("ns3::TcpSocket::SndBufSize", UintegerValue(32*1024*1024));
+    Config::SetDefault("ns3::TcpSocket::RcvBufSize", UintegerValue(32*1024*1024));
+    Config::SetDefault("ns3::TcpSocket::InitialSlowStartThreshold", UintegerValue(initial_ssthresh_pkts*1380));
+    Config::SetDefault("ns3::TcpSocketState::EnablePacing", BooleanValue(cc == "TcpBbr"));
+    NodeContainer nodes; nodes.Create(2);
+    InternetStackHelper stack; stack.Install(nodes);
+    PointToPointHelper link;
+    link.SetDeviceAttribute("DataRate", StringValue(std::to_string(rate) + "Mbps"));
+    link.SetChannelAttribute("Delay", TimeValue(MilliSeconds(before_ms)));
+    link.SetQueue("ns3::DropTailQueue<Packet>", "MaxSize", QueueSizeValue(QueueSize(std::to_string(queue_pkts)+"p")));
+    auto devices = link.Install(nodes);
+    Ipv4AddressHelper addresses; addresses.SetBase("10.1.1.0", "255.255.255.0");
+    auto interfaces = addresses.Assign(devices);
+    // Match the course's device-only drop-tail queues; address assignment can
+    // otherwise install a default AQM root qdisc and confound the delay-step test.
+    TrafficControlHelper traffic;
+    traffic.Uninstall(devices);
+    if (loss_s >= 0 || loss_seq != 0) {
+        auto em = CreateObject<StudyDropOnce>(loss_s, loss_seq);
+        devices.Get(1)->SetAttribute("ReceiveErrorModel", PointerValue(em));
+    }
+    cs30401study::Install(nodes);
+    TcpFlowSinkHelper sink("ns3::TcpSocketFactory", InetSocketAddress(Ipv4Address::GetAny(), 1024));
+    auto sinks = sink.Install(nodes.Get(1)); sinks.Start(Seconds(0));
+    TcpFlowSendHelper source("ns3::TcpSocketFactory", InetSocketAddress(interfaces.GetAddress(1),1024),
+                             max_bytes, 0, true, run_dir+"/logs_ns3", parameters);
+    auto apps = source.Install(nodes.Get(0)); apps.Start(Seconds(flow_start_s));
+    auto channel = DynamicCast<PointToPointChannel>(devices.Get(0)->GetChannel());
+    Simulator::Schedule(Seconds(event_s), [channel, after_ms]() {
+        channel->SetAttribute("Delay", TimeValue(MilliSeconds(after_ms)));
+    });
+    Simulator::Stop(Seconds(duration));
+    Simulator::Run();
+    apps.Get(0)->GetObject<TcpFlowSendApplication>()->FinalizeDetailedLogs();
+    std::ofstream config(run_dir+"/config_ns3.properties");
+    config << "simulation_end_time_ns=" << int64_t(duration*1e9) << '\n';
+    Simulator::Destroy();
+    return 0;
+}
diff --git a/scratch/vegas_micro/vegas_micro.cc b/scratch/vegas_micro/vegas_micro.cc
new file mode 100755
index 0000000..facff47
--- /dev/null
+++ b/scratch/vegas_micro/vegas_micro.cc
@@ -0,0 +1,486 @@
+// Controlled propagation/queue diagnostic, not the multi-hop LEO model.
+// Copy to scratch/vegas_micro/vegas_micro.cc in the official patched ns-3.48 environment.
+// Requires the team's existing study packet/sink instrumentation and Vegas patch.
+#include "ns3/core-module.h"
+#include "ns3/network-module.h"
+#include "ns3/internet-module.h"
+#include "ns3/point-to-point-module.h"
+#include "ns3/traffic-control-module.h"
+#include "ns3/tcp-flow-send-helper.h"
+#include "ns3/tcp-flow-sink-helper.h"
+#include "ns3/tcp-flow-send-application.h"
+#include "../main_satnet/study_drop_trace.h"
+
+#include <cmath>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <map>
+#include <memory>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <tuple>
+#include <vector>
+
+using namespace ns3;
+
+namespace {
+
+void Require(bool condition, const std::string& message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+Time ChannelDelay(Ptr<PointToPointChannel> channel) {
+    TimeValue delay;
+    channel->GetAttribute("Delay", delay);
+    return delay.Get();
+}
+
+void SetEnvironment(const char* name, const std::string& value) {
+#ifdef _WIN32
+    Require(_putenv_s(name, value.c_str()) == 0, "Cannot set environment variable");
+#else
+    Require(setenv(name, value.c_str(), 1) == 0, "Cannot set environment variable");
+#endif
+}
+
+std::string JsonString(const std::string& value) {
+    std::ostringstream out;
+    out << '"';
+    for (unsigned char c : value) {
+        if (c == '"' || c == '\\') out << '\\' << c;
+        else if (c < 0x20) out << "\\u" << std::hex << std::setw(4) << std::setfill('0')
+                               << unsigned(c) << std::dec;
+        else out << c;
+    }
+    out << '"';
+    return out.str();
+}
+
+struct PacketIdentity {
+    uint64_t uid;
+    bool tagged;
+    uint64_t flowId{0};
+    uint64_t txId{0};
+    int64_t txTimeNs{0};
+
+    using Key = std::tuple<uint64_t, bool, uint64_t, uint64_t>;
+    Key GetKey() const { return {uid, tagged, flowId, txId}; }
+};
+
+PacketIdentity Identify(Ptr<const Packet> packet) {
+    PacketIdentity id{packet->GetUid(), false};
+    TcpStudyTxTag tag;
+    id.tagged = packet->PeekPacketTag(tag);
+    if (id.tagged) {
+        id.flowId = tag.GetFlowId();
+        id.txId = tag.GetTxId();
+        id.txTimeNs = tag.GetTxTimeNs();
+    }
+    return id;
+}
+
+void WriteIdentity(std::ostream& out, const PacketIdentity& id) {
+    out << id.uid << ',' << (id.tagged ? 1 : 0) << ',';
+    if (id.tagged) out << id.flowId;
+    out << ',';
+    if (id.tagged) out << id.txId;
+    out << ',';
+    if (id.tagged) out << id.txTimeNs;
+}
+
+struct QueueLogs {
+    std::ofstream events, sojourn, occupancy, coverage, pending, summary;
+    explicit QueueLogs(const std::string& folder)
+        : events(folder + "/queue_events.csv"), sojourn(folder + "/queue_sojourn.csv"),
+          occupancy(folder + "/queue_occupancy.csv"), coverage(folder + "/queue_coverage.csv"),
+          pending(folder + "/queue_pending.csv"), summary(folder + "/queue_summary.csv") {
+        Require(events && sojourn && occupancy && coverage && pending && summary,
+                "Cannot open queue trace files");
+        events << "time_ns,node_id,device_id,direction,event,packet_uid,tagged,flow_id,tx_id,"
+                  "tx_time_ns,packet_bytes,queue_packets,queue_bytes\n";
+        sojourn << "dequeue_time_ns,enqueue_time_ns,sojourn_ns,node_id,device_id,direction,"
+                   "packet_uid,tagged,flow_id,tx_id,tx_time_ns,packet_bytes\n";
+        occupancy << "time_ns,node_id,device_id,direction,old_packets,new_packets,queue_bytes\n";
+        coverage << "node_id,device_id,direction,layer,connected\n";
+        pending << "observation_end_ns,enqueue_time_ns,age_ns,node_id,device_id,direction,"
+                   "packet_uid,tagged,flow_id,tx_id,tx_time_ns,packet_bytes\n";
+        summary << "node_id,device_id,direction,enqueued,dequeued,drop_before_enqueue,"
+                   "drop_after_dequeue,pending,zero_sojourn\n";
+    }
+};
+
+// DropTail uses Dequeue for service, but Queue::Remove also emits Dequeue before
+// DropAfterDequeue. Log both traces; analysis must exclude those removal records
+// from service statistics. This driver never calls Remove or installs an AQM.
+class QueueObserver {
+public:
+    QueueObserver(Ptr<PointToPointNetDevice> device, std::string direction,
+                  std::shared_ptr<QueueLogs> logs)
+        : m_device(device), m_queue(device->GetQueue()), m_direction(std::move(direction)),
+          m_logs(std::move(logs)) {
+        Require(m_queue != nullptr, "Missing point-to-point device queue");
+        Connect("Enqueue", MakeCallback(&QueueObserver::Enqueue, this));
+        Connect("Dequeue", MakeCallback(&QueueObserver::Dequeue, this));
+        Connect("DropBeforeEnqueue", MakeCallback(&QueueObserver::DropBefore, this));
+        Connect("DropAfterDequeue", MakeCallback(&QueueObserver::DropAfter, this));
+        Connect("PacketsInQueue", MakeCallback(&QueueObserver::Occupancy, this));
+        Snapshot();
+    }
+
+    void Finish() {
+        Snapshot();
+        Require(m_waiting.size() == m_queue->GetNPackets(), "Queue tracking count mismatch");
+        Require(m_enqueued == m_dequeued + m_waiting.size(), "Queue conservation mismatch");
+        // This assertion also makes every logged sojourn a served dequeue in
+        // this DropTail scenario; a future queue implementation must revisit it.
+        Require(m_dropAfter == 0, "Unexpected Remove/DropAfterDequeue; service analysis invalid");
+        for (const auto& [key, waiting] : m_waiting) {
+            (void) key;
+            const int64_t now = Simulator::Now().GetNanoSeconds();
+            m_logs->pending << now << ',' << waiting.enqueueNs << ',' << now - waiting.enqueueNs << ',';
+            WriteLocation(m_logs->pending);
+            WriteIdentity(m_logs->pending, waiting.id);
+            m_logs->pending << ',' << waiting.bytes << '\n';
+        }
+        WriteLocation(m_logs->summary);
+        m_logs->summary << m_enqueued << ',' << m_dequeued << ',' << m_dropBefore << ','
+                        << m_dropAfter << ',' << m_waiting.size() << ',' << m_zeroSojourn << '\n';
+    }
+
+private:
+    struct Waiting { int64_t enqueueNs; uint32_t bytes; PacketIdentity id; };
+    Ptr<PointToPointNetDevice> m_device;
+    Ptr<Queue<Packet>> m_queue;
+    std::string m_direction;
+    std::shared_ptr<QueueLogs> m_logs;
+    std::map<PacketIdentity::Key, Waiting> m_waiting;
+    uint64_t m_enqueued{0}, m_dequeued{0}, m_dropBefore{0}, m_dropAfter{0}, m_zeroSojourn{0};
+
+    template<typename CallbackType>
+    void Connect(const std::string& layer, CallbackType callback) {
+        const bool ok = m_queue->TraceConnectWithoutContext(layer, callback);
+        WriteLocation(m_logs->coverage);
+        m_logs->coverage << layer << ',' << (ok ? 1 : 0) << '\n';
+        Require(ok, "Missing queue trace: " + layer);
+    }
+
+    void WriteLocation(std::ostream& out) const {
+        out << m_device->GetNode()->GetId() << ',' << m_device->GetIfIndex() << ',' << m_direction << ',';
+    }
+
+    void LogPacket(const std::string& event, Ptr<const Packet> packet) {
+        m_logs->events << Simulator::Now().GetNanoSeconds() << ',';
+        WriteLocation(m_logs->events);
+        m_logs->events << event << ',';
+        WriteIdentity(m_logs->events, Identify(packet));
+        m_logs->events << ',' << packet->GetSize() << ',' << m_queue->GetNPackets() << ','
+                       << m_queue->GetNBytes() << '\n';
+    }
+
+    void Enqueue(Ptr<const Packet> packet) {
+        const auto id = Identify(packet);
+        Require(m_waiting.emplace(id.GetKey(), Waiting{Simulator::Now().GetNanoSeconds(),
+                                                      packet->GetSize(), id}).second,
+                "Duplicate transmission identity concurrently in queue");
+        ++m_enqueued;
+        LogPacket("Enqueue", packet);
+    }
+
+    void Dequeue(Ptr<const Packet> packet) {
+        const auto id = Identify(packet);
+        auto entry = m_waiting.find(id.GetKey());
+        Require(entry != m_waiting.end(), "Dequeue without observed enqueue");
+        const int64_t now = Simulator::Now().GetNanoSeconds();
+        const int64_t wait = now - entry->second.enqueueNs;
+        Require(wait >= 0 && entry->second.bytes == packet->GetSize(), "Queue packet changed");
+        m_logs->sojourn << now << ',' << entry->second.enqueueNs << ',' << wait << ',';
+        WriteLocation(m_logs->sojourn);
+        WriteIdentity(m_logs->sojourn, id);
+        m_logs->sojourn << ',' << packet->GetSize() << '\n';
+        if (wait == 0) ++m_zeroSojourn;
+        m_waiting.erase(entry);
+        ++m_dequeued;
+        LogPacket("Dequeue", packet);
+    }
+
+    void DropBefore(Ptr<const Packet> packet) {
+        ++m_dropBefore;
+        LogPacket("DropBeforeEnqueue", packet);
+    }
+
+    void DropAfter(Ptr<const Packet> packet) {
+        ++m_dropAfter;
+        LogPacket("DropAfterDequeue", packet);
+    }
+
+    void Occupancy(uint32_t oldValue, uint32_t newValue) {
+        m_logs->occupancy << Simulator::Now().GetNanoSeconds() << ',';
+        WriteLocation(m_logs->occupancy);
+        // ns-3.48 Queue::DoEnqueue/DoDequeue update m_nBytes before m_nPackets.
+        // Thus GetNBytes is the post-change queued-byte count at this callback.
+        m_logs->occupancy << oldValue << ',' << newValue << ',' << m_queue->GetNBytes() << '\n';
+    }
+
+    void Snapshot() { Occupancy(m_queue->GetNPackets(), m_queue->GetNPackets()); }
+};
+
+// TcpFlowSendApplication creates its socket in StartApplication, not Install.
+// A node-local SocketType switch before the later start affects only NEW sockets.
+// Inspect the actual sender sockets rather than inferring CCA from defaults.
+void VerifySocketType(Ptr<TcpL4Protocol> tcp, uint16_t port, uint32_t flowId,
+                      const std::string& expected, std::ofstream* out) {
+    ObjectMapValue sockets;
+    tcp->GetAttribute("SocketList", sockets);
+    uint32_t found = 0;
+    for (auto it = sockets.Begin(); it != sockets.End(); ++it) {
+        auto socket = DynamicCast<TcpSocketBase>(it->second);
+        Address peer;
+        if (!socket || socket->GetPeerName(peer) != 0 || !InetSocketAddress::IsMatchingType(peer)) continue;
+        if (InetSocketAddress::ConvertFrom(peer).GetPort() != port) continue;
+        PointerValue algorithm;
+        socket->GetAttribute("CongestionOps", algorithm);
+        auto ops = algorithm.Get<TcpCongestionOps>();
+        Require(ops != nullptr, "Missing socket congestion-control object");
+        const std::string actual = ops->GetInstanceTypeId().GetName();
+        Require(actual == expected, "Wrong congestion-control type on flow " + std::to_string(flowId));
+        *out << Simulator::Now().GetNanoSeconds() << ',' << flowId << ',' << port << ','
+             << expected << ',' << actual << '\n';
+        ++found;
+    }
+    Require(found == 1, "Expected exactly one sender socket for port " + std::to_string(port));
+}
+
+struct AppDelivery { uint64_t bytes{0}; int64_t lastNs{-1}; };
+
+AppDelivery ReadAppDelivery(const std::string& path, uint32_t flowId) {
+    std::ifstream input(path);
+    Require(bool(input), "Missing receiver application trace: " + path);
+    std::string line;
+    std::getline(input, line);
+    Require(line == "time_ns,node_id,connection_id,local_ip,local_port,peer_ip,peer_port,"
+                    "flow_id,packet_uid,payload_bytes,connection_total_rx_bytes,sink_total_rx_bytes",
+            "Unexpected receiver application trace schema");
+    AppDelivery delivery;
+    while (std::getline(input, line)) {
+        std::vector<std::string> fields;
+        std::istringstream row(line);
+        std::string field;
+        while (std::getline(row, field, ',')) fields.push_back(field);
+        Require(fields.size() == 12, "Malformed receiver application row");
+        Require(fields[7] == std::to_string(flowId), "Receiver trace has missing/wrong flow tag");
+        delivery.bytes += std::stoull(fields[9]);
+        Require(delivery.bytes == std::stoull(fields[10]), "Application cumulative bytes mismatch");
+        Require(delivery.bytes == std::stoull(fields[11]), "Unexpected second connection on sink port");
+        delivery.lastNs = std::stoll(fields[0]);
+    }
+    return delivery;
+}
