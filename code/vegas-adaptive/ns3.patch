+void
+TcpVegas::AdaptiveDecision(Ptr<TcpSocketState> tcb, uint32_t diff)
+{
+    // Endpoint estimate, not receiver goodput. Inputs are unchanged course SRTT.
+    const uint32_t before = tcb->m_cWnd.Get();
