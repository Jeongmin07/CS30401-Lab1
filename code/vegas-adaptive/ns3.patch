+        m_alphaFloor = m_alpha;
+        m_betaFloor = m_beta;
+        m_adaptiveFloorSet = true;
+    }
+    const uint32_t alphaBefore = m_alpha, betaBefore = m_beta;
+    const bool hadPrevious = m_previousRateValid;
+    const double previous = m_previousRate;
+    const char* rule = "band-hold";
+    int change = 0;
+    if (!hadPrevious)
+    {
+        // No cross-startup/recovery comparison: ordinary Vegas seeds history.
+        rule = "seed-ordinary";
+        change = diff > m_beta ? -1 : (diff < m_alpha ? 1 : 0);
+    }
+    else if (diff > m_beta)
+    {
+        rule = "above-beta";
+        change = -1;
+        if (m_alpha > m_alphaFloor) --m_alpha;
+        if (m_beta > m_betaFloor) --m_beta;
+    }
+    else if (diff < m_alpha)
+    {
+        if (m_alpha > m_alphaFloor && rate < previous)
+        {
+            rule = "below-alpha-rate-fell";
+            change = -1;
+            --m_alpha;
+            if (m_beta > m_betaFloor) --m_beta;
+        }
+        else if (m_alpha == m_alphaFloor || rate > previous)
+        {
+            rule = "below-alpha-grow";
+            change = 1;
+        }
+        else rule = "below-alpha-equal-hold";
+    }
+    else if (rate > previous)
+    {
+        rule = "band-rate-rose";
+        change = 1;
+        NS_ABORT_MSG_IF(m_alpha == UINT32_MAX || m_beta == UINT32_MAX,
+                        "Adaptive threshold overflow");
+        ++m_alpha;
+        ++m_beta;
+    }
+    if (change < 0)
+    {
+        window = std::max(2u, window - 1);
+        tcb->m_cWnd = window * tcb->m_segmentSize;
+        tcb->m_ssThresh = GetSsThresh(tcb, 0);
+    }
+    else if (change > 0)
+    {
+        tcb->m_cWnd = (window + 1) * tcb->m_segmentSize;
+    }
+    const char* directory = std::getenv("CS30401_VEGAS_TRACE_DIR");
+    if (directory && directory[0])
+    {
+        static std::unique_ptr<std::ofstream> out;
+        if (!out)
+        {
+            out = std::make_unique<std::ofstream>(std::string(directory) + "/adaptive_state.csv");
+            NS_ABORT_MSG_IF(!out->good(), "Cannot open adaptive trace");
+            *out << "time_ns,vegas_instance,rule,diff_pkts,rate_pkts_s,previous_rate_pkts_s,previous_valid,alpha_before,beta_before,alpha_after,beta_after,cwnd_before_bytes,cwnd_after_bytes,segment_size,cycle_min_rtt_ns,base_rtt_ns,alpha_floor,beta_floor,cong_state\n";
+            out->precision(17);
+        }
+        *out << Simulator::Now().GetNanoSeconds() << ',' << m_traceInstance << ',' << rule << ','
+             << diff << ',' << rate << ',' << previous << ',' << hadPrevious << ','
+             << alphaBefore << ',' << betaBefore << ',' << m_alpha << ',' << m_beta << ','
+             << before << ',' << tcb->m_cWnd.Get() << ',' << tcb->m_segmentSize << ','
+             << m_minRtt.GetNanoSeconds() << ',' << m_baseRtt.GetNanoSeconds() << ','
+             << m_alphaFloor << ',' << m_betaFloor << ',' << static_cast<int>(tcb->m_congState)
+             << '\n';
+    }
+    m_previousRate = rate;
+    m_previousRateValid = true;
+}
+
+void
+TcpVegas::TraceStudy(Ptr<TcpSocketState> tcb, const char* event,
+                     uint32_t before, int64_t diff, Time oldBase, Time recent,
+                     bool validCycle, uint32_t beforeSs, int announcedState)
+{
+    const char* directory = std::getenv("CS30401_VEGAS_TRACE_DIR");
+    if (!directory || !directory[0]) return;
+    static std::unique_ptr<std::ofstream> stream;
+    static uint32_t nextInstance = 0;
+    if (!stream)
+    {
+        stream = std::make_unique<std::ofstream>(std::string(directory) + "/vegas_state.csv");
+        NS_ABORT_MSG_IF(!stream->good(), "Cannot open Vegas study trace");
+        *stream << "time_ns,vegas_instance,event,base_rtt_ns,cycle_min_rtt_ns,rtt_samples,cwnd_before_bytes,cwnd_after_bytes,ssthresh_bytes,diff_pkts,cong_state,renewal_enabled,renewal_rounds,renewal_count,old_base_rtt_ns,recent_min_ns,history_rounds,history_elapsed_ns,valid_renewal_cycle,ssthresh_before_bytes,announced_state\n";
+    }
+    if (!m_traceInstance) m_traceInstance = ++nextInstance;
+    auto timeField = [](Time value) { if (value != Time::Max()) *stream << value.GetNanoSeconds(); };
+    *stream << Simulator::Now().GetNanoSeconds() << ',' << m_traceInstance << ',' << event << ',';
+    timeField(m_baseRtt); *stream << ','; timeField(m_minRtt);
+    *stream << ',' << m_cntRtt << ',' << before << ',' << tcb->m_cWnd.Get() << ',' << tcb->m_ssThresh.Get() << ',';
+    if (diff >= 0) *stream << diff;
+    *stream << ',' << static_cast<int>(tcb->m_congState) << ',' << m_recentMinRenewal << ','
+            << m_renewalRounds << ',' << m_renewalCount << ',';
+    timeField(oldBase); *stream << ','; timeField(recent);
+    *stream << ',' << m_renewalHistory.size() << ',';
+    if (!m_renewalHistory.empty()) *stream << (Simulator::Now() - m_renewalHistory.front().first).GetNanoSeconds();
+    *stream << ',' << validCycle << ',' << beforeSs << ',';
+    if (announcedState >= 0) *stream << announcedState;
+    *stream << '\n';
+}
