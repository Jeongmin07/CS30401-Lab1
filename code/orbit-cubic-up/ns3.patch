+void TcpFlowSendApplication::InitializeStudy() {
+    m_socket->GetObject<TcpSocketBase>()->SetOrbitWindowObservationFlow(m_tcpFlowId);
+    // Semicolon-separated controls avoid commas in the scheduler CSV column.
+    if (!m_additionalParameters.empty()) {
+        for (const std::string& token : split_string(m_additionalParameters, ";")) {
+            if (token.empty()) {
+                continue;
+            }
+            auto eq = token.find('=');
+            std::string key = trim(token.substr(0, eq));
+            if (key != "study_threshold" && key != "study_windows" &&
+                key != "study_restore_limit_ns" && key != "study_short_flow_cutoff_pkts") {
+                NS_ABORT_MSG_IF(key.compare(0, 6, "study_") == 0,
+                                "Unknown study parameter: " << key);
+                continue; // Other metadata remains compatible with existing schedules.
+            }
+            NS_ABORT_MSG_IF(eq == std::string::npos, "Missing value for " << key);
+            std::string value = trim(token.substr(eq + 1));
+            if (key == "study_threshold") {
+                int64_t parsed = parse_positive_int64(value);
+                NS_ABORT_MSG_IF(parsed < 3 ||
+                                static_cast<uint64_t>(parsed) > std::numeric_limits<uint32_t>::max(),
+                                "study_threshold must be between 3 and UINT32_MAX");
+                m_studyThreshold = static_cast<uint32_t>(parsed);
+            } else if (key == "study_short_flow_cutoff_pkts") {
+                int64_t parsed = parse_positive_int64(value);
+                NS_ABORT_MSG_IF(parsed <= 0 ||
+                                static_cast<uint64_t>(parsed) > std::numeric_limits<uint32_t>::max(),
+                                "study_short_flow_cutoff_pkts must be between 1 and UINT32_MAX");
+                m_studyShortFlowCutoffPackets = static_cast<uint32_t>(parsed);
+            } else if (key == "study_restore_limit_ns") {
+                m_studyRestoreLimitNs = parse_positive_int64(value);
+                NS_ABORT_MSG_IF(m_studyRestoreLimitNs <= 0,
+                                "study_restore_limit_ns must be positive");
+            } else {
+                NS_ABORT_MSG_IF(value.empty(), "study_windows cannot be empty");
+                for (const std::string& interval : split_string(value, "|")) {
+                    auto bounds = split_string(interval, ":", 2);
+                    int64_t start = parse_positive_int64(trim(bounds[0]));
+                    int64_t end = parse_positive_int64(trim(bounds[1]));
+                    NS_ABORT_MSG_IF(start >= end, "Study window must have start < end");
+                    NS_ABORT_MSG_IF(!m_studyWindows.empty() &&
+                                    start < m_studyWindows.back().second,
+                                    "Study windows must be sorted and non-overlapping");
+                    m_studyWindows.emplace_back(start, end);
+                }
+            }
+        }
+    }
+    const char* enabled = std::getenv("CS30401_STUDY_TRACE");
+    m_studyLogging = m_enableDetailedLogging && enabled && std::string(enabled) == "1";
+    if (m_studyLogging) {
+        std::ofstream events(m_baseLogsDir + "/" +
+                             format_string("tcp_flow_%" PRIu64 "_study_events.csv", m_tcpFlowId));
+        events << "flow_id,time_ns,event,old_value,new_value,threshold,cong_state\n";
+        std::ofstream packets(m_baseLogsDir + "/" +
+                              format_string("tcp_flow_%" PRIu64 "_study_packets.csv", m_tcpFlowId));
+        packets << "flow_id,time_ns,event,packet_uid,tx_id,tx_time_ns,seq,ack,payload_bytes,flags,"
+                   "sack_blocks,threshold,cong_state,local_port,peer_port\n";
+    }
+    bool ok;
+    if (m_studyLogging || !m_studyWindows.empty()) {
+        ok = m_socket->TraceConnectWithoutContext(
+            "CongState", MakeCallback(&TcpFlowSendApplication::StudyCongState, this));
+        NS_ABORT_MSG_IF(!ok, "Missing TCP CongState trace");
+    }
+    if (m_studyLogging) {
+        ok = m_socket->TraceConnectWithoutContext(
+            "SlowStartThreshold", MakeCallback(&TcpFlowSendApplication::StudySsThresh, this));
+        NS_ABORT_MSG_IF(!ok, "Missing TCP SlowStartThreshold trace");
+        ok = m_socket->TraceConnectWithoutContext(
+            "Tx", MakeCallback(&TcpFlowSendApplication::StudyTx, this));
+        NS_ABORT_MSG_IF(!ok, "Missing TCP Tx trace");
+        ok = m_socket->TraceConnectWithoutContext(
+            "Retransmission", MakeCallback(&TcpFlowSendApplication::StudyRetransmission, this));
+        NS_ABORT_MSG_IF(!ok, "Missing TCP Retransmission trace");
+    }
+    if (m_studyLogging || !m_studyWindows.empty()) {
+        ok = m_socket->TraceConnectWithoutContext(
+            "Rx", MakeCallback(&TcpFlowSendApplication::StudyRx, this));
+        NS_ABORT_MSG_IF(!ok, "Missing TCP Rx trace");
+    }
+    m_studyEffectiveThreshold = m_studyThreshold;
+    if (m_studyShortFlowCutoffPackets != 0 && m_maxBytes != 0) {
+        UintegerValue segmentSizeValue;
+        m_socket->GetAttribute("SegmentSize", segmentSizeValue);
+        uint64_t segmentSize = segmentSizeValue.Get();
+        NS_ABORT_MSG_IF(segmentSize == 0, "Short-flow cutoff requires a nonzero SegmentSize");
+        // This is a nominal MSS-equivalent size, not a measured packet count.
+        // Classify once, before Connect: no threshold lowering with live dupacks
+        // and no assumption that changing K reevaluates an existing SACK scoreboard.
+        uint64_t nominalPackets = m_maxBytes / segmentSize +
+                                  (m_maxBytes % segmentSize != 0);
+        InsertStudyEvent("SHORT_FLOW_SIZE_BYTES", m_maxBytes, segmentSize);
+        InsertStudyEvent("SHORT_FLOW_NOMINAL_MSS", nominalPackets, m_studyShortFlowCutoffPackets);
+        if (nominalPackets <= m_studyShortFlowCutoffPackets && m_studyThreshold > 3) {
+            m_studyEffectiveThreshold = 3;
+            InsertStudyEvent("SHORT_FLOW_GUARD_BYPASS", m_studyThreshold, 3);
+        }
+    }
+    // Set explicitly to distinguish study baseline from unrecorded global defaults.
+    SetStudyThreshold(m_studyWindows.empty() ? m_studyEffectiveThreshold : 3, "THRESHOLD_INIT");
+    int64_t now = Simulator::Now().GetNanoSeconds();
+    for (const auto& interval : m_studyWindows) {
+        if (interval.second <= now) {
+            continue;
+        }
+        if (interval.first <= now) {
+            BeginStudyWindow();
+        } else {
+            m_studyWindowEvents.push_back(Simulator::Schedule(
+                NanoSeconds(interval.first - now),
+                &TcpFlowSendApplication::BeginStudyWindow, this));
+        }
+        m_studyWindowEvents.push_back(Simulator::Schedule(
+            NanoSeconds(interval.second - now),
+            &TcpFlowSendApplication::EndStudyWindow, this));
+    }
+}
+
+void TcpFlowSendApplication::SetStudyThreshold(uint32_t threshold, const std::string& event) {
+    if (!m_socket) {
+        return;
+    }
+    uint32_t old = m_studyCurrentThreshold;
+    m_socket->GetObject<TcpSocketBase>()->SetRetxThresh(threshold);
+    m_studyCurrentThreshold = threshold;
+    InsertStudyEvent(event, old, threshold);
+}
+
+void TcpFlowSendApplication::BeginStudyWindow() {
+    if (!m_socket) {
+        return;
+    }
+    ++m_studyActiveWindows;
+    m_studyRestorePending = false;
+    m_studyRestoreDeadlineEvent.Cancel();
+    SetStudyThreshold(m_studyEffectiveThreshold, "THRESHOLD_SET");
+}
+
+void TcpFlowSendApplication::EndStudyWindow() {
+    if (!m_socket || m_studyActiveWindows == 0) {
+        return;
+    }
+    --m_studyActiveWindows;
+    if (m_studyActiveWindows != 0) {
+        return;
+    }
+    m_studyRestorePending = true;
+    if (m_studyCongState != TcpSocketState::CA_OPEN &&
+        m_studyCongState != TcpSocketState::CA_LOSS) {
+        InsertStudyEvent("THRESHOLD_RESTORE_DEFERRED",
+                         m_studyCurrentThreshold, m_studyCurrentThreshold);
+    }
+    m_studyRestoreDeadlineEvent = Simulator::Schedule(
+        NanoSeconds(m_studyRestoreLimitNs),
+        &TcpFlowSendApplication::StudyRestoreDeadline, this);
+    // Run after any current ACK/RTO handler has finished resetting its counters.
+    Simulator::ScheduleNow(&TcpFlowSendApplication::TryRestoreStudyThreshold, this);
+}
+
+void TcpFlowSendApplication::TryRestoreStudyThreshold() {
+    if (!m_socket || !m_studyRestorePending || m_studyActiveWindows != 0) {
+        return;
+    }
+    // CA_OPEN reached after cumulative ACK processing resets duplicate ACK count.
+    // CA_LOSS ignores dupacks and the RTO handler resets the count before its state trace.
+    // Never lower the threshold blindly while CA_DISORDER/CA_RECOVERY is active.
+    if (m_studyCongState == TcpSocketState::CA_OPEN ||
+        m_studyCongState == TcpSocketState::CA_LOSS) {
+        SetStudyThreshold(3, "THRESHOLD_RESTORE");
+        m_studyRestorePending = false;
+        m_studyRestoreDeadlineEvent.Cancel();
+    }
+}
+
+void TcpFlowSendApplication::StudyRestoreDeadline() {
+    if (m_studyRestorePending && m_socket) {
+        InsertStudyEvent("RESTORE_DEADLINE_MISSED",
+                         m_studyCurrentThreshold, m_studyCurrentThreshold);
+        // The deadline is an observable cost limit, not an unsafe force-reset.
+        // Continue restoring at the next safe state and report the overrun.
+    }
+}
+
+void TcpFlowSendApplication::CancelStudyEvents() {
+    for (auto& event : m_studyWindowEvents) {
+        event.Cancel();
+    }
+    m_studyWindowEvents.clear();
+    m_studyRestoreDeadlineEvent.Cancel();
+}
+
+void TcpFlowSendApplication::InsertStudyEvent(const std::string& event,
+                                             uint64_t oldValue, uint64_t newValue) {
+    if (!m_studyLogging) {
+        return;
+    }
+    std::ofstream& out = CachedLogStream(m_baseLogsDir + "/" +
+        format_string("tcp_flow_%" PRIu64 "_study_events.csv", m_tcpFlowId));
+    out << m_tcpFlowId << ',' << Simulator::Now().GetNanoSeconds() << ',' << event << ','
+        << oldValue << ',' << newValue << ',' << m_studyCurrentThreshold << ','
+        << static_cast<unsigned>(m_studyCongState) << '\n';
+}
+
+void TcpFlowSendApplication::StudyCongState(TcpSocketState::TcpCongState_t oldState,
+                                           TcpSocketState::TcpCongState_t newState) {
+    m_studyCongState = newState;
+    InsertStudyEvent("CONG", static_cast<unsigned>(oldState), static_cast<unsigned>(newState));
+    if (m_studyRestorePending) {
+        Simulator::ScheduleNow(&TcpFlowSendApplication::TryRestoreStudyThreshold, this);
+    }
+}
+
+void TcpFlowSendApplication::StudySsThresh(uint32_t oldValue, uint32_t newValue) {
+    InsertStudyEvent("SSTHRESH", oldValue, newValue);
+}
+
+void TcpFlowSendApplication::StudyTx(Ptr<const Packet> packet, const TcpHeader& header,
+                                    Ptr<const TcpSocketBase> socket) {
+    // Replace metadata on this outgoing copy so TCP retransmissions get new IDs.
+    TcpStudyTxTag previous;
+    Ptr<Packet> mutablePacket = ConstCast<Packet>(packet);
+    mutablePacket->RemovePacketTag(previous);
+    mutablePacket->AddPacketTag(
+        TcpStudyTxTag(m_tcpFlowId, ++m_studyTxId, Simulator::Now().GetNanoSeconds()));
+    InsertStudyPacket("TX", packet, header);
+}
+
+void TcpFlowSendApplication::StudyRx(Ptr<const Packet> packet, const TcpHeader& header,
+                                    Ptr<const TcpSocketBase> socket) {
+    if (header.GetFlags() & TcpHeader::ACK) {
+        InsertStudyPacket("RX_ACK", packet, header);
+    }
+    if (m_studyRestorePending) {
+        // Rx trace occurs before ProcessAck; restore only after its state update.
+        Simulator::ScheduleNow(&TcpFlowSendApplication::TryRestoreStudyThreshold, this);
+    }
+}
+
+void TcpFlowSendApplication::StudyRetransmission(Ptr<const Packet> packet,
+                                                const TcpHeader& header,
+                                                const Address& localAddr,
+                                                const Address& peerAddr,
+                                                Ptr<const TcpSocketBase> socket) {
+    // TcpSocketBase fires this immediately after Tx for the very same packet.
+    InsertStudyPacket("RETX", packet, header);
+}
+
+void TcpFlowSendApplication::InsertStudyPacket(const std::string& event,
+                                               Ptr<const Packet> packet,
+                                               const TcpHeader& header) {
+    if (!m_studyLogging) {
+        return;
+    }
+    TcpStudyTxTag tag;
+    bool tagged = packet->PeekPacketTag(tag);
+    std::ostringstream sack;
+    if (header.HasOption(TcpOption::SACK)) {
+        Ptr<const TcpOptionSack> option =
+            DynamicCast<const TcpOptionSack>(header.GetOption(TcpOption::SACK));
+        bool first = true;
+        for (const auto& block : option->GetSackList()) {
+            if (!first) {
+                sack << '|';
+            }
+            first = false;
+            sack << block.first.GetValue() << ':' << block.second.GetValue();
+        }
     }
+    bool receive = event == "RX_ACK";
+    std::ofstream& out = CachedLogStream(m_baseLogsDir + "/" +
+        format_string("tcp_flow_%" PRIu64 "_study_packets.csv", m_tcpFlowId));
+    out << m_tcpFlowId << ',' << Simulator::Now().GetNanoSeconds() << ',' << event << ','
+        << packet->GetUid() << ',' << (tagged ? tag.GetTxId() : 0) << ','
+        << (tagged ? tag.GetTxTimeNs() : -1) << ',' << header.GetSequenceNumber().GetValue()
+        << ',' << header.GetAckNumber().GetValue() << ',' << packet->GetSize() << ','
+        << static_cast<unsigned>(header.GetFlags()) << ',' << sack.str() << ','
+        << m_studyCurrentThreshold << ',' << static_cast<unsigned>(m_studyCongState) << ','
+        << (receive ? header.GetDestinationPort() : header.GetSourcePort()) << ','
+        << (receive ? header.GetSourcePort() : header.GetDestinationPort()) << '\n';
 }
 
 } // Namespace ns3
