new file mode 100644
index 0000000..8fc3acf
--- /dev/null
+++ b/scratch/main_satnet/orbit_cubic_queue.h
@@ -0,0 +1,194 @@
+#ifndef CS30401_ORBIT_CUBIC_QUEUE_OBSERVER_H
+#define CS30401_ORBIT_CUBIC_QUEUE_OBSERVER_H
+#include "ns3/ipv4-l3-protocol.h"
+#include "ns3/ipv4-header.h"
+#include "ns3/tcp-header.h"
+#include "ns3/ppp-header.h"
+#include "ns3/point-to-point-laser-net-device.h"
+#include "ns3/gsl-net-device.h"
+#include "ns3/point-to-point-net-device.h"
+#include "ns3/tcp-flow-send-application.h"
+#include "ns3/traffic-control-layer.h"
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <vector>
+#include <algorithm>
+#include <cstdint>
+
+namespace ns3 { namespace orbitcubicqueue {
+static std::unique_ptr<std::ofstream> drops, coverage, queues, pendingCsv;
+struct Counters { uint64_t enq{0}, deq{0}, before{0}, after{0}, samples{0}, sum{0}, max{0}; };
+struct Pending { int64_t time; uint64_t flow; };
+struct QueueRecord {
+    uint32_t node, device;
+    Ptr<Queue<Packet>> queue;
+    int64_t bucket{-1};
+    std::map<uint64_t, Counters> counters;
+    // Queue::DoEnqueue stores this same Ptr; DoDequeue traces the stored Ptr.
+    // Fragments can share a UID, so UID is not a unique queue-entry identity.
+    std::map<const Packet*, Pending> pending;
+};
+static std::vector<std::unique_ptr<QueueRecord>> records;
+static uint64_t Flow(Ptr<const Packet> p) {
+    TcpStudyTxTag tag;
+    return p->PeekPacketTag(tag) ? tag.GetFlowId() : UINT64_MAX;
+}
+static void FlushQueue(QueueRecord& r) {
+    if (r.bucket < 0) return;
+    for (const auto& entry : r.counters) {
+        const auto& c = entry.second;
+        *queues << r.bucket * 100000000 << ',' << (r.bucket + 1) * 100000000
+                << ',' << r.node << ',' << r.device << ',';
+        if (entry.first != UINT64_MAX) *queues << entry.first;
+        *queues << ',' << c.enq << ',' << c.deq << ',' << c.before << ',' << c.after
+                << ',' << c.samples << ',' << c.sum << ',' << c.max
+                << ',' << Simulator::Now().GetNanoSeconds()
+                << ',' << r.queue->GetNPackets() << ',' << r.queue->GetNBytes() << '\n';
+    }
+    r.counters.clear();
+}
+static Counters& At(QueueRecord* r, Ptr<const Packet> p) {
+    const int64_t bucket = Simulator::Now().GetNanoSeconds() / 100000000;
+    if (r->bucket != bucket) { FlushQueue(*r); r->bucket = bucket; }
+    return r->counters[Flow(p)];
+}
+static void Enqueue(QueueRecord* r, Ptr<const Packet> p) {
+    ++At(r,p).enq;
+    const Packet* key = PeekPointer(p);
+    NS_ABORT_MSG_IF(r->pending.count(key), "Same Packet object queued twice in one device queue");
+    r->pending[key] = {Simulator::Now().GetNanoSeconds(), Flow(p)};
+}
+static void Dequeue(QueueRecord* r, Ptr<const Packet> p) {
+    auto& c = At(r,p); ++c.deq;
+    auto it = r->pending.find(PeekPointer(p));
+    NS_ABORT_MSG_IF(it == r->pending.end(), "Dequeue without observed enqueue");
+    NS_ABORT_MSG_IF(Flow(p) != it->second.flow, "Flow metadata changed inside device queue");
+    const uint64_t wait = Simulator::Now().GetNanoSeconds() - it->second.time;
+    ++c.samples; c.sum += wait; c.max = std::max(c.max, wait);
+    r->pending.erase(it);
+}
+static void QueueBefore(QueueRecord* r, Ptr<const Packet> p) { ++At(r,p).before; }
+static void QueueAfter(QueueRecord* r, Ptr<const Packet> p) {
+    ++At(r,p).after;
+    // Dequeue precedes DropAfterDequeue, so served-sojourn interpretation fails.
+    NS_ABORT_MSG_IF(true,"DropAfterDequeue is outside served-sojourn observer semantics");
+}
+static void Drop(uint32_t node, uint32_t device, std::string layer,
+                 Ptr<const Packet> p, const Ipv4Header* supplied=nullptr, int reason=-1) {
+    auto copy = p->Copy();
+    Ipv4Header ip;
+    bool parsed = false;
+    if (supplied) { ip = *supplied; parsed = true; }
+    else if (copy->GetSize() >= 20) {
+        uint8_t bytes[2]; copy->CopyData(bytes,2);
+        if ((bytes[0] >> 4) != 4 && bytes[0] == 0 && bytes[1] == 0x21) {
+            PppHeader ppp; copy->RemoveHeader(ppp);
+        }
+        copy->CopyData(bytes,1);
+        if ((bytes[0] >> 4) == 4) parsed = copy->RemoveHeader(ip) > 0;
+    }
+    *drops << Simulator::Now().GetNanoSeconds() << ',' << node << ',' << device << ','
+           << layer << ',' << reason << ',' << p->GetUid() << ',';
+    const uint64_t flow = Flow(p);
+    if (flow != UINT64_MAX) *drops << flow;
+    *drops << ',';
+    if (parsed) *drops << ip.GetSource() << ',' << ip.GetDestination(); else *drops << ',';
+    *drops << ',';
+    if (parsed && ip.GetProtocol() == 6 && ip.GetFragmentOffset() == 0 && copy->GetSize() >= 20) {
+        TcpHeader tcp; copy->RemoveHeader(tcp);
+        *drops << tcp.GetSourcePort() << ',' << tcp.GetDestinationPort() << ','
+               << tcp.GetSequenceNumber().GetValue() << ',' << copy->GetSize();
+    } else *drops << ",,,";
+    *drops << '\n';
+}
+static void DeviceDrop(uint32_t node,uint32_t device,std::string layer,Ptr<const Packet> p) {
+    Drop(node,device,layer,p);
+}
+static void IpDrop(uint32_t node,const Ipv4Header& ip,Ptr<const Packet> p,
+                   Ipv4L3Protocol::DropReason reason,Ptr<Ipv4>,uint32_t interface) {
+    Drop(node,interface,"ipv4",p,&ip,static_cast<int>(reason));
+}
+static void Finish() {
+    const int64_t cutoff = Simulator::Now().GetNanoSeconds();
+    for (auto& r : records) {
+        FlushQueue(*r);
+        NS_ABORT_MSG_IF(r->pending.size() != r->queue->GetNPackets(),
+                        "Observed pending count differs from actual device queue");
+        std::map<uint64_t, Counters> byFlow;
+        for (const auto& item : r->pending) {
+            auto& row = byFlow[item.second.flow];
+            const uint64_t age = cutoff - item.second.time;
+            ++row.samples; row.sum += age; row.max = std::max(row.max,age);
+        }
+        for (const auto& item : byFlow) {
+            *pendingCsv << cutoff << ',' << r->node << ',' << r->device << ',';
+            if (item.first != UINT64_MAX) *pendingCsv << item.first;
+            *pendingCsv << ',' << item.second.samples << ',' << item.second.sum
+                        << ',' << item.second.max << '\n';
+        }
+    }
+    queues->flush(); drops->flush(); coverage->flush(); pendingCsv->flush();
+}
+static void Install(NodeContainer nodes) {
+    const char* enabled = std::getenv("CS30401_ORBIT_QUEUE_TRACE");
+    if (!enabled || std::string(enabled) != "1") return;
+    const char* directory = std::getenv("CS30401_ORBIT_QUEUE_TRACE_DIR");
+    NS_ABORT_MSG_IF(!directory, "Observation directory is required");
+    drops = std::make_unique<std::ofstream>(std::string(directory)+"/orbit_drops.csv");
+    coverage = std::make_unique<std::ofstream>(std::string(directory)+"/orbit_coverage.csv");
+    queues = std::make_unique<std::ofstream>(std::string(directory)+"/orbit_queue_bins.csv");
+    pendingCsv = std::make_unique<std::ofstream>(std::string(directory)+"/orbit_queue_pending.csv");
+    NS_ABORT_MSG_IF(!drops->good() || !coverage->good() || !queues->good() || !pendingCsv->good(), "Cannot open network observers");
+    *drops << "time_ns,node_id,device_id,layer,reason,packet_uid,flow_id,src,dst,src_port,dst_port,seq,payload_bytes\n";
+    *coverage << "node_id,device_id,layer,connected\n";
+    *queues << "bin_start_ns,bin_end_ns,node_id,device_id,flow_id,enqueued,dequeued,drop_before,drop_after,sojourn_samples,sojourn_sum_ns,sojourn_max_ns,flush_time_ns,queue_packets_at_flush,queue_bytes_at_flush\n";
+    *pendingCsv << "cutoff_ns,node_id,device_id,flow_id,pending_packets,pending_age_sum_ns,max_pending_age_ns\n";
+    for (auto it=nodes.Begin();it!=nodes.End();++it) {
+        auto node=*it;
+        auto ip=node->GetObject<Ipv4L3Protocol>();
+        bool ok=ip && ip->TraceConnectWithoutContext("Drop",MakeBoundCallback(&IpDrop,node->GetId()));
+        *coverage << node->GetId() << ",-1,ipv4," << ok << '\n';
+        NS_ABORT_MSG_IF(!ok,"Missing IPv4 drop observer");
+        auto tc=node->GetObject<TrafficControlLayer>();
+        ok=tc && tc->TraceConnectWithoutContext("TcDrop",MakeBoundCallback(&DeviceDrop,node->GetId(),UINT32_MAX,std::string("TcDrop")));
+        *coverage << node->GetId() << ",-1,TcDrop," << ok << '\n';
+        NS_ABORT_MSG_IF(!ok,"Missing TcDrop observer");
+        for (uint32_t i=0;i<node->GetNDevices();++i) {
+            auto device=node->GetDevice(i);
+            Ptr<Queue<Packet>> queue;
+            if (auto isl=DynamicCast<PointToPointLaserNetDevice>(device)) queue=isl->GetQueue();
+            else if (auto gsl=DynamicCast<GSLNetDevice>(device)) queue=gsl->GetQueue();
+            else if (auto p2p=DynamicCast<PointToPointNetDevice>(device)) queue=p2p->GetQueue();
+            else continue;
+            NS_ABORT_MSG_IF(!queue,"Missing device queue");
+            ok=!tc->GetRootQueueDiscOnDevice(device);
+            *coverage << node->GetId() << ',' << i << ",root_queue_disc_absent," << ok << '\n';
+            NS_ABORT_MSG_IF(!ok,"Root QueueDisc is outside this observer's coverage");
+            auto r=std::make_unique<QueueRecord>(); r->node=node->GetId(); r->device=i; r->queue=queue;
+            for (const std::string layer : {"MacTxDrop","PhyTxDrop","PhyRxDrop"}) {
+                ok=device->TraceConnectWithoutContext(layer,MakeBoundCallback(&DeviceDrop,node->GetId(),i,layer));
+                *coverage << node->GetId() << ',' << i << ',' << layer << ',' << ok << '\n';
+                NS_ABORT_MSG_IF(!ok,"Missing device drop observer");
+            }
+            for (const auto& hook : std::vector<std::pair<std::string,Callback<void,Ptr<const Packet>>>>{
+                {"Enqueue",MakeBoundCallback(&Enqueue,r.get())},
+                {"Dequeue",MakeBoundCallback(&Dequeue,r.get())},
+                {"DropBeforeEnqueue",MakeBoundCallback(&QueueBefore,r.get())},
+                {"DropAfterDequeue",MakeBoundCallback(&QueueAfter,r.get())}}) {
+                ok=queue->TraceConnectWithoutContext(hook.first,hook.second);
+                *coverage << node->GetId() << ',' << i << ',' << hook.first << ',' << ok << '\n';
+                NS_ABORT_MSG_IF(!ok,"Missing queue observer");
+            }
+            // Also preserve sparse, attributable drop records at the device queue layer.
+            for (const std::string layer : {"DropBeforeEnqueue","DropAfterDequeue"})
+                NS_ABORT_MSG_IF(!queue->TraceConnectWithoutContext(layer,MakeBoundCallback(&DeviceDrop,node->GetId(),i,layer)),"Missing queue drop observer");
+            records.push_back(std::move(r));
+        }
+    }
+    coverage->flush();
+    Simulator::ScheduleDestroy(&Finish);
+}
+}} // ns3::orbitcubicqueue
+#endif
diff --git a/scratch/main_satnet/orbit_cubic_service.h b/scratch/main_satnet/orbit_cubic_service.h
new file mode 100644
index 0000000..4a70bae
--- /dev/null
+++ b/scratch/main_satnet/orbit_cubic_service.h
@@ -0,0 +1,76 @@
+#ifndef CS30401_ORBIT_CUBIC_SERVICE_H
+#define CS30401_ORBIT_CUBIC_SERVICE_H
+#include "orbit_cubic_queue.h"
+namespace ns3 { namespace orbitcubicservice {
+struct Count {uint64_t busy{0}, packets{0}, bytes{0};};
+struct Record {
+    uint32_t node,device;
+    Ptr<const Packet> active;
+    int64_t start{-1};
+    uint64_t flow{UINT64_MAX};
+    std::map<std::pair<int64_t,uint64_t>,Count> bins;
+};
+static std::vector<std::unique_ptr<Record>> records;
+static std::unique_ptr<std::ofstream> output,coverage;
+static uint64_t Flow(Ptr<const Packet> p) {TcpStudyTxTag t;return p->PeekPacketTag(t)?t.GetFlowId():UINT64_MAX;}
+static void AddBusy(Record& r,int64_t end) {
+    NS_ABORT_MSG_IF(end<r.start,"Service time decreases");
+    for (int64_t t=r.start;t<end;) {
+        const int64_t bucket=t/100000000;
+        const int64_t next=std::min(end,(bucket+1)*100000000);
+        r.bins[{bucket,r.flow}].busy+=next-t;t=next;
+    }
+}
+static void Begin(Record* r,Ptr<const Packet> p) {
+    NS_ABORT_MSG_IF(r->active,"Overlapping transmission on one device");
+    r->active=p;r->start=Simulator::Now().GetNanoSeconds();r->flow=Flow(p);
+    auto& c=r->bins[{r->start/100000000,r->flow}];++c.packets;c.bytes+=p->GetSize();
+}
+static void End(Record* r,Ptr<const Packet> p) {
+    NS_ABORT_MSG_IF(!r->active || PeekPointer(r->active)!=PeekPointer(p),"Service end packet differs from begin");
+    NS_ABORT_MSG_IF(Flow(p)!=r->flow,"Flow changed during serialization");
+    AddBusy(*r,Simulator::Now().GetNanoSeconds());r->active=nullptr;r->start=-1;
+}
+static void Finish() {
+    const int64_t cutoff=Simulator::Now().GetNanoSeconds();
+    for (auto& r:records) {
+        if (r->active) AddBusy(*r,cutoff);
+        for (const auto& e:r->bins) {
+            const auto& c=e.second;
+            *output << e.first.first*100000000 << ',' << (e.first.first+1)*100000000
+                    << ',' << r->node << ',' << r->device << ',';
+            if (e.first.second!=UINT64_MAX) *output << e.first.second;
+            *output << ',' << c.busy << ',' << c.packets << ',' << c.bytes
+                    << ',' << cutoff << ',' << bool(r->active) << '\n';
+        }
+    }
+    output->flush();coverage->flush();
+}
+static void Install(NodeContainer nodes) {
+    const char* enabled=std::getenv("CS30401_ORBIT_SERVICE_TRACE");
+    if (!enabled || std::string(enabled)!="1") return;
+    const char* directory=std::getenv("CS30401_STUDY_TRACE_DIR");
+    NS_ABORT_MSG_IF(!directory,"Missing service directory");
+    output=std::make_unique<std::ofstream>(std::string(directory)+"/orbit_service_bins.csv");
+    coverage=std::make_unique<std::ofstream>(std::string(directory)+"/orbit_service_coverage.csv");
+    NS_ABORT_MSG_IF(!output->good() || !coverage->good(),"Cannot create service trace");
+    *output << "bin_start_ns,bin_end_ns,node_id,device_id,flow_id,busy_ns,tx_packets,serialized_bytes_started,cutoff_ns,device_tx_active_at_cutoff\n";
+    *coverage << "node_id,device_id,hook,connected\n";
+    for (auto it=nodes.Begin();it!=nodes.End();++it) {
+        auto node=*it;
+        for (uint32_t i=0;i<node->GetNDevices();++i) {
+            auto dev=node->GetDevice(i);
+            if (!DynamicCast<GSLNetDevice>(dev) && !DynamicCast<PointToPointLaserNetDevice>(dev) && !DynamicCast<PointToPointNetDevice>(dev)) continue;
+            auto r=std::make_unique<Record>();r->node=node->GetId();r->device=i;
+            bool ok=dev->TraceConnectWithoutContext("PhyTxBegin",MakeBoundCallback(&Begin,r.get()));
+            *coverage << node->GetId() << ',' << i << ",PhyTxBegin," << ok << '\n';
+            NS_ABORT_MSG_IF(!ok,"Missing PhyTxBegin");
+            ok=dev->TraceConnectWithoutContext("PhyTxEnd",MakeBoundCallback(&End,r.get()));
+            *coverage << node->GetId() << ',' << i << ",PhyTxEnd," << ok << '\n';
+            NS_ABORT_MSG_IF(!ok,"Missing PhyTxEnd");records.push_back(std::move(r));
+        }
+    }
+    Simulator::ScheduleDestroy(&Finish);
+}
+}}
+#endif
diff --git a/scratch/main_satnet/study_drop_trace.h b/scratch/main_satnet/study_drop_trace.h
new file mode 100755
index 0000000..c9c2c0f
--- /dev/null
+++ b/scratch/main_satnet/study_drop_trace.h
@@ -0,0 +1,115 @@
+#ifndef CS30401_STUDY_DROP_TRACE_H
+#define CS30401_STUDY_DROP_TRACE_H
+
+#include "ns3/ipv4-l3-protocol.h"
+#include "ns3/ipv4-header.h"
+#include "ns3/tcp-header.h"
+#include "ns3/ppp-header.h"
+#include "ns3/point-to-point-laser-net-device.h"
+#include "ns3/gsl-net-device.h"
+#include "ns3/point-to-point-net-device.h"
+#include "ns3/tcp-flow-send-application.h"
+#include "ns3/traffic-control-layer.h"
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+
+namespace ns3 {
+namespace cs30401study {
+static std::unique_ptr<std::ofstream> drops;
+static std::unique_ptr<std::ofstream> coverage;
+
+static void WriteDrop(uint32_t node, uint32_t device, const std::string& layer,
+                      int reason, Ptr<const Packet> packet, const Ipv4Header* ip = nullptr) {
+    Ptr<Packet> copy = packet->Copy();
+    Ipv4Header header;
+    bool parsed = false;
+    if (ip) {
+        header = *ip;
+        parsed = true;
+    } else if (copy->GetSize() >= 20) {
+        uint8_t first[2];
+        copy->CopyData(first, 2);
+        if ((first[0] >> 4) != 4 && first[0] == 0 && first[1] == 0x21) {
+            PppHeader ppp;
+            copy->RemoveHeader(ppp);
+        }
+        copy->CopyData(first, 1);
+        if ((first[0] >> 4) == 4) parsed = copy->RemoveHeader(header) > 0;
+    }
+    *drops << Simulator::Now().GetNanoSeconds() << ',' << layer << ',' << node << ','
+           << device << ',' << reason << ',' << packet->GetUid() << ',';
+    if (parsed) *drops << header.GetSource() << ',' << header.GetDestination();
+    else *drops << ',';
+    *drops << ',';
+    if (parsed && header.GetProtocol() == 6 && header.GetFragmentOffset() == 0 && copy->GetSize() >= 20) {
+        TcpHeader tcp;
+        copy->RemoveHeader(tcp);
+        *drops << tcp.GetSourcePort() << ',' << tcp.GetDestinationPort() << ','
+               << tcp.GetSequenceNumber().GetValue() << ',' << copy->GetSize() << ',' << unsigned(tcp.GetFlags());
+    } else *drops << ",,,,";
+    TcpStudyTxTag tag;
+    if (packet->PeekPacketTag(tag)) {
+        *drops << ',' << tag.GetFlowId() << ',' << tag.GetTxId() << ',' << tag.GetTxTimeNs();
+    } else *drops << ",,,";
+    *drops << '\n';
+}
+
+static void DeviceDrop(uint32_t node, uint32_t device, std::string layer, Ptr<const Packet> packet) {
+    WriteDrop(node, device, layer, -1, packet);
+}
+static void IpDrop(uint32_t node, const Ipv4Header& header, Ptr<const Packet> packet,
+                   Ipv4L3Protocol::DropReason reason, Ptr<Ipv4> ipv4, uint32_t interface) {
+    WriteDrop(node, interface, "ipv4", int(reason), packet, &header);
+}
+
+static void Install(NodeContainer nodes) {
+    const char* enabled = std::getenv("CS30401_STUDY_TRACE");
+    if (!enabled || std::string(enabled) != "1") return;
+    const char* folder = std::getenv("CS30401_STUDY_TRACE_DIR");
+    if (!folder) throw std::runtime_error("CS30401_STUDY_TRACE_DIR is required for study traces");
+    drops = std::make_unique<std::ofstream>(std::string(folder) + "/study_drops.csv");
+    coverage = std::make_unique<std::ofstream>(std::string(folder) + "/study_drop_coverage.csv");
+    if (!*drops || !*coverage) throw std::runtime_error("Cannot open study drop traces");
+    *drops << "time_ns,layer,node,device,reason,uid,src,dst,src_port,dst_port,seq,payload_bytes,flags,flow_id,tx_id,tx_time_ns\n";
+    *coverage << "node,device,layer,connected\n";
+    for (auto it = nodes.Begin(); it != nodes.End(); ++it) {
+        Ptr<Node> node = *it;
+        Ptr<Ipv4L3Protocol> ip = node->GetObject<Ipv4L3Protocol>();
+        bool ok = ip && ip->TraceConnectWithoutContext("Drop", MakeBoundCallback(&IpDrop, node->GetId()));
+        *coverage << node->GetId() << ",-1,ipv4," << ok << '\n';
+        if (!ok) throw std::runtime_error("Missing IPv4 drop trace");
+        Ptr<TrafficControlLayer> tc = node->GetObject<TrafficControlLayer>();
+        ok = tc && tc->TraceConnectWithoutContext("TcDrop",
+             MakeBoundCallback(&DeviceDrop, node->GetId(), uint32_t(-1), std::string("TcDrop")));
+        *coverage << node->GetId() << ",-1,TcDrop," << ok << '\n';
+        if (!ok) throw std::runtime_error("Missing traffic-control drop trace");
+        for (uint32_t index = 0; index < node->GetNDevices(); ++index) {
+            Ptr<NetDevice> device = node->GetDevice(index);
+            Ptr<Queue<Packet>> queue;
+            if (auto isl = DynamicCast<PointToPointLaserNetDevice>(device)) queue = isl->GetQueue();
+            else if (auto gsl = DynamicCast<GSLNetDevice>(device)) queue = gsl->GetQueue();
+            else if (auto p2p = DynamicCast<PointToPointNetDevice>(device)) queue = p2p->GetQueue();
+            else continue; // Loopback is not an ISL/GSL forwarding link.
+            ok = !tc->GetRootQueueDiscOnDevice(device);
+            *coverage << node->GetId() << ',' << index << ",root_queue_disc_absent," << ok << '\n';
+            if (!ok) throw std::runtime_error("Root queue disc requires a QueueDisc::Drop hook or explicit removal");
+            // MacRxDrop is unimplemented (#if 0) in these device classes.
+            for (const std::string layer : {"MacTxDrop", "PhyTxDrop", "PhyRxDrop"}) {
+                ok = device->TraceConnectWithoutContext(layer, MakeBoundCallback(&DeviceDrop, node->GetId(), index, layer));
+                *coverage << node->GetId() << ',' << index << ',' << layer << ',' << ok << '\n';
+                if (!ok) throw std::runtime_error("Missing device drop trace: " + layer);
+            }
+            if (!queue) throw std::runtime_error("Missing ISL/GSL queue");
+            for (const std::string layer : {"DropBeforeEnqueue", "DropAfterDequeue"}) {
+                ok = queue->TraceConnectWithoutContext(layer, MakeBoundCallback(&DeviceDrop, node->GetId(), index, layer));
+                *coverage << node->GetId() << ',' << index << ',' << layer << ',' << ok << '\n';
+                if (!ok) throw std::runtime_error("Missing queue drop trace: " + layer);
+            }
+        }
+    }
+    coverage->flush();
+}
+} // namespace cs30401study
+} // namespace ns3
+#endif
diff --git a/scratch/study_micro/study_micro.cc b/scratch/study_micro/study_micro.cc
new file mode 100755
index 0000000..6b58540
--- /dev/null
+++ b/scratch/study_micro/study_micro.cc
@@ -0,0 +1,103 @@
+// Controlled delay-step diagnostic. It is not a replacement for the LEO model.
+#include "ns3/core-module.h"
+#include "ns3/network-module.h"
+#include "ns3/internet-module.h"
+#include "ns3/point-to-point-module.h"
+#include "ns3/traffic-control-module.h"
+#include "ns3/tcp-flow-send-helper.h"
+#include "ns3/tcp-flow-sink-helper.h"
+#include "ns3/tcp-flow-send-application.h"
+#include "../main_satnet/study_drop_trace.h"
+#include <filesystem>
+using namespace ns3;
+
+class StudyDropOnce : public ErrorModel {
+public:
+    StudyDropOnce(double time, uint32_t sequence) : m_time(time), m_sequence(sequence) {}
+private:
+    bool DoCorrupt(Ptr<Packet> packet) override {
+        if (m_used || (m_time < 0 && m_sequence == 0) ||
+            (m_time >= 0 && Simulator::Now().GetSeconds() < m_time)) return false;
+        auto copy = packet->Copy();
+        PppHeader ppp; Ipv4Header ip; TcpHeader tcp;
+        if (copy->GetSize() < 42) return false;
+        copy->RemoveHeader(ppp);
+        if (ppp.GetProtocol() != 0x21) return false;
+        copy->RemoveHeader(ip);
+        if (ip.GetProtocol() != 6) return false;
+        copy->RemoveHeader(tcp);
+        if (!copy->GetSize()) return false;
+        if (m_sequence != 0 && tcp.GetSequenceNumber().GetValue() != m_sequence) return false;
+        m_used = true;
+        return true;
+    }
+    void DoReset() override { m_used = false; }
+    double m_time;
+    uint32_t m_sequence;
+    bool m_used = false;
+};
+
+int main(int argc, char** argv) {
+    std::string run_dir, parameters, cc = "TcpCubic";
+    double duration = 20, rate = 100, before_ms = 50, after_ms = 45, event_s = 10, loss_s = -1, flow_start_s = 0;
+    uint32_t queue_pkts = 2000, initial_ssthresh_pkts = 900, loss_seq = 0;
+    uint64_t max_bytes = 100000000000ULL;
+    CommandLine cmd;
+    cmd.AddValue("run_dir", "Output directory", run_dir);
+    cmd.AddValue("parameters", "TCP study additional parameters", parameters);
+    cmd.AddValue("cc", "TCP class name", cc);
+    cmd.AddValue("duration", "Simulation seconds", duration);
+    cmd.AddValue("rate", "Link Mbit/s", rate);
+    cmd.AddValue("before_ms", "Initial one-way propagation ms", before_ms);
+    cmd.AddValue("after_ms", "One-way propagation after step ms", after_ms);
+    cmd.AddValue("event_s", "Delay-step time", event_s);
+    cmd.AddValue("loss_s", "Drop one data packet at or after this time (-1 disables)", loss_s);
+    cmd.AddValue("loss_seq", "Only drop this starting TCP data sequence once (0 uses time only)", loss_seq);
+    cmd.AddValue("queue_pkts", "Drop-tail queue packets", queue_pkts);
+    cmd.AddValue("initial_ssthresh_pkts", "Controlled initial slow-start threshold packets", initial_ssthresh_pkts);
+    cmd.AddValue("max_bytes", "Finite transfer bytes (default effectively infinite)", max_bytes);
+    cmd.AddValue("flow_start_s", "Application start time in simulation seconds", flow_start_s);
+    cmd.Parse(argc, argv);
+    if (run_dir.empty()) throw std::runtime_error("run_dir required");
+    std::filesystem::create_directories(run_dir + "/logs_ns3");
+    Config::SetDefault("ns3::TcpL4Protocol::SocketType", StringValue("ns3::" + cc));
+    Config::SetDefault("ns3::TcpSocket::SegmentSize", UintegerValue(1380));
+    Config::SetDefault("ns3::TcpSocket::SndBufSize", UintegerValue(32*1024*1024));
+    Config::SetDefault("ns3::TcpSocket::RcvBufSize", UintegerValue(32*1024*1024));
+    Config::SetDefault("ns3::TcpSocket::InitialSlowStartThreshold", UintegerValue(initial_ssthresh_pkts*1380));
+    Config::SetDefault("ns3::TcpSocketState::EnablePacing", BooleanValue(cc == "TcpBbr"));
+    NodeContainer nodes; nodes.Create(2);
+    InternetStackHelper stack; stack.Install(nodes);
+    PointToPointHelper link;
+    link.SetDeviceAttribute("DataRate", StringValue(std::to_string(rate) + "Mbps"));
+    link.SetChannelAttribute("Delay", TimeValue(MilliSeconds(before_ms)));
+    link.SetQueue("ns3::DropTailQueue<Packet>", "MaxSize", QueueSizeValue(QueueSize(std::to_string(queue_pkts)+"p")));
+    auto devices = link.Install(nodes);
+    Ipv4AddressHelper addresses; addresses.SetBase("10.1.1.0", "255.255.255.0");
+    auto interfaces = addresses.Assign(devices);
+    // Match the course's device-only drop-tail queues; address assignment can
+    // otherwise install a default AQM root qdisc and confound the delay-step test.
+    TrafficControlHelper traffic;
+    traffic.Uninstall(devices);
+    if (loss_s >= 0 || loss_seq != 0) {
+        auto em = CreateObject<StudyDropOnce>(loss_s, loss_seq);
+        devices.Get(1)->SetAttribute("ReceiveErrorModel", PointerValue(em));
+    }
+    cs30401study::Install(nodes);
+    TcpFlowSinkHelper sink("ns3::TcpSocketFactory", InetSocketAddress(Ipv4Address::GetAny(), 1024));
+    auto sinks = sink.Install(nodes.Get(1)); sinks.Start(Seconds(0));
+    TcpFlowSendHelper source("ns3::TcpSocketFactory", InetSocketAddress(interfaces.GetAddress(1),1024),
+                             max_bytes, 0, true, run_dir+"/logs_ns3", parameters);
+    auto apps = source.Install(nodes.Get(0)); apps.Start(Seconds(flow_start_s));
+    auto channel = DynamicCast<PointToPointChannel>(devices.Get(0)->GetChannel());
+    Simulator::Schedule(Seconds(event_s), [channel, after_ms]() {
+        channel->SetAttribute("Delay", TimeValue(MilliSeconds(after_ms)));
+    });
+    Simulator::Stop(Seconds(duration));
+    Simulator::Run();
+    apps.Get(0)->GetObject<TcpFlowSendApplication>()->FinalizeDetailedLogs();
+    std::ofstream config(run_dir+"/config_ns3.properties");
+    config << "simulation_end_time_ns=" << int64_t(duration*1e9) << '\n';
+    Simulator::Destroy();
+    return 0;
+}
